---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";
---

<Layout title="Nexus — Tu suite privada de productividad">
  <Navbar />

  <main>
    <section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-violet-600/10 blur-[120px]"></div>
        <div class="absolute top-1/3 -left-20 h-[400px] w-[400px] rounded-full bg-blue-600/10 blur-[100px]"></div>
        <div class="absolute top-1/3 -right-20 h-[400px] w-[400px] rounded-full bg-cyan-600/10 blur-[100px]"></div>
      </div>

      <div class="relative z-10 max-w-4xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-white/70">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Privacidad por diseño, no como opción
        </div>

        <h1 class="mb-6 text-5xl font-extrabold leading-tight tracking-tight md:text-7xl">
          Productividad que
          <span class="bg-gradient-to-r from-violet-400 via-blue-400 to-cyan-400 bg-clip-text text-transparent">
            respeta tu privacidad
          </span>
        </h1>

        <p class="mx-auto mb-10 max-w-2xl text-lg text-white/50 md:text-xl">
          Una suite completa de herramientas para tu vida digital.
          Sin publicidad. Sin vender tus datos. Sin letra pequeña.
        </p>

        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="#productos" class="rounded-full bg-gradient-to-r from-violet-600 to-blue-600 px-8 py-3.5 font-semibold transition hover:opacity-90 hover:shadow-lg hover:shadow-violet-500/25">
            Explorar productos →
          </a>
          <a href="#precios" class="rounded-full border border-white/10 bg-white/5 px-8 py-3.5 font-semibold transition hover:bg-white/10">
            Ver precios
          </a>
        </div>

        <div class="mt-16 flex flex-wrap justify-center gap-10 text-center">
          {[
            { value: "100M+", label: "Usuarios" },
            { value: "6", label: "Aplicaciones" },
            { value: "0", label: "Anuncios" },
            { value: "2013", label: "Desde" },
          ].map((stat) => (
            <div>
              <div class="text-3xl font-bold">{stat.value}</div>
              <div class="text-sm text-white/40">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="productos" class="mx-auto max-w-7xl px-6 py-24">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-4xl font-bold">Todo lo que necesitas, en un solo lugar</h2>
        <p class="text-white/50">Cada herramienta diseñada desde cero con tu privacidad como prioridad.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </section>

    <section id="privacidad" class="border-t border-white/5 bg-white/[0.02] py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-16 lg:grid-cols-2">
          <div>
            <h2 class="mb-6 text-4xl font-bold leading-tight">
              Construido sobre
              <span class="bg-gradient-to-r from-violet-400 to-blue-400 bg-clip-text text-transparent">
                confianza real
              </span>
            </h2>
            <p class="mb-8 leading-relaxed text-white/50">
              No es un eslogan de marketing. Cada producto está construido con cifrado
              de extremo a extremo por defecto, lo que significa que técnicamente
              es imposible que nosotros leamos tu información.
            </p>
            <ul class="space-y-4">
              {[
                "Código abierto y auditado por terceros",
                "Sin publicidad ni venta de datos",
                "Servidores propios en Suiza (jurisdicción neutral)",
                "Cifrado E2E en todos los productos",
              ].map((item) => (
                <li class="flex items-center gap-3 text-white/70">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs text-emerald-400">
                    ✓
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-8">
            <div class="mb-6 flex items-center gap-3">
              <div class="h-3 w-3 rounded-full bg-red-500"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
              <div class="h-3 w-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-xs text-white/30">cifrado.nexus.app</span>
            </div>
            <div class="space-y-3 font-mono text-sm">
              <div class="text-white/30">// Lo que otros ven:</div>
              <div class="rounded-lg bg-white/5 p-3 text-emerald-400">
                xK9$mP2#nQ8@vL5&wR3...
              </div>
              <div class="mt-4 text-white/30">// Lo que tú ves:</div>
              <div class="rounded-lg bg-white/5 p-3 text-white/80">
                Hola mamá, llego a las 8 🙂
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="precios" class="border-t border-white/5 py-24">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="mb-4 text-4xl font-bold">Precios simples y transparentes</h2>
        <p class="mx-auto max-w-2xl text-white/50">
          Empieza gratis y escala cuando lo necesites. Sin sorpresas ni comisiones ocultas.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
