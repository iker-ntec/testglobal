---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { products, type Product } from "../../data/products";

interface Props {
  product: Product;
}

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as Props;
const productHref = product.href === "#" ? "/#productos" : product.href;
const isExternal = product.href !== "#";
---

<Layout title={`${product.name} - Nexus`} description={product.tagline}>
  <Navbar />

  <main class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <a
      href="/#productos"
      class="mb-12 inline-flex items-center gap-2 text-sm text-white/40 transition hover:text-white"
    >
      &larr; Volver a Nexus
    </a>

    <section class={`mb-12 rounded-2xl border bg-gradient-to-br p-10 ${product.color} ${product.border}`}>
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="mb-4 text-6xl" aria-hidden="true">{product.icon}</div>
          <h1 class="mb-2 text-4xl font-extrabold">{product.name}</h1>
          <p class="text-xl text-white/60">{product.tagline}</p>
        </div>

        {product.tag && (
          <span class={`rounded-full bg-gradient-to-r px-4 py-1.5 text-sm font-semibold ${product.badge}`}>
            {product.tag}
          </span>
        )}
      </div>

      <p class="mt-6 max-w-2xl leading-relaxed text-white/50">{product.description}</p>

      <div class="mt-8">
        <a
          href={productHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class={`inline-block rounded-full bg-gradient-to-r px-8 py-3 font-semibold transition hover:opacity-90 ${product.badge}`}
        >
          Abrir {product.name} &rarr;
        </a>
      </div>
    </section>

    <section class="rounded-2xl border border-white/5 bg-white/[0.02] p-10 text-center">
      <p class="text-white/30">Mas detalles sobre {product.name} proximamente.</p>
    </section>
  </main>

  <Footer />
</Layout>
