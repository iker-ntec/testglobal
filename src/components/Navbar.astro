---
import MobileMenu from "./MobileMenu.vue";
import { navLinks } from "../data/navigation";
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-[#0f0f14]/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-violet-500 to-blue-500 text-sm">
        N
      </span>
      Nexus
    </a>

    <ul class="hidden items-center gap-8 text-sm text-white/60 md:flex">
      {navLinks.map((link) => (
        <li><a href={link.href} class="transition hover:text-white">{link.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a href="#" class="hidden text-sm text-white/60 transition hover:text-white md:block">
        Iniciar sesion
      </a>
      <a
        href="#"
        class="hidden rounded-full bg-gradient-to-r from-violet-600 to-blue-600 px-5 py-2 text-sm font-medium transition hover:opacity-90 md:block"
      >
        Crear cuenta gratis
      </a>

      <MobileMenu links={navLinks} client:idle />
    </div>
  </nav>
</header>
