---
import type { Product } from "../data/products";

type Props = Product;

const { name, slug, tagline, description, icon, color, border, badge, tag } = Astro.props as Props;
const internalHref = `/productos/${slug}`;
---

<a
  href={internalHref}
  class={`group relative flex flex-col rounded-2xl border bg-gradient-to-br p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${color} ${border}`}
>
  {tag && (
    <span class={`absolute right-4 top-4 rounded-full bg-gradient-to-r px-3 py-1 text-xs font-semibold ${badge}`}>
      {tag}
    </span>
  )}

  <div class="mb-4 text-4xl" aria-hidden="true">{icon}</div>

  <h3 class="mb-1 text-lg font-bold">{name}</h3>
  <p class="mb-3 text-sm font-medium text-white/60">{tagline}</p>
  <p class="text-sm leading-relaxed text-white/40">{description}</p>

  <div class="mt-6 flex items-center gap-1 text-sm font-medium text-white/40 transition group-hover:text-white/80">
    Ver {name}
    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
  </div>
</a>
